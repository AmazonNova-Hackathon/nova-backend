    {
      "name": "📋 Reports & Uploads",
      "item": [
        {
          "name": "1. Get Pre-Signed Upload URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.url) { pm.environment.set('s3_presigned_url', json.url); }",
                  "if (json.s3Key) { pm.environment.set('s3_key', json.s3Key); }",
                  "if (json.reportId) { pm.environment.set('reportId', json.reportId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/families/{{familyId}}/members/{{memberId}}/reports/upload-url?contentType=image/png",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "families",
                "{{familyId}}",
                "members",
                "{{memberId}}",
                "reports",
                "upload-url"
              ],
              "query": [
                {
                  "key": "contentType",
                  "value": "image/png"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Upload Binary to S3",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/png",
                "type": "text"
              }
            ],
            "body": {
              "mode": "file",
              "file": {}
            },
            "url": {
              "raw": "{{s3_presigned_url}}",
              "host": [
                "{{s3_presigned_url}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Trigger Processing (Manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
