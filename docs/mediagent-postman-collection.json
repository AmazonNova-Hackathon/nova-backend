	"variable": [
		{
			"key": "base_url",
			"value": "https://REPLACE_ME.execute-api.us-east-1.amazonaws.com/prod",
			"type": "string"
		},
		{
			"key": "api_key",
			"value": "REPLACE_ME",
			"type": "string"
		}
	]
