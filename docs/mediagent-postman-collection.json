{
	"info": {
		"_postman_id": "fdbe87f9-da03-49d7-83d2-c2e50529944a",
		"name": "MediAgent API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Step 1: Get Upload URL",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/reports/upload-url?patientId=patient-demo-001",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"reports",
						"upload-url"
					],
					"query": [
						{
							"key": "patientId",
							"value": "patient-demo-001"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Step 2: Upload to S3 (Direct)",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "image/jpeg",
						"type": "text"
					}
				],
				"body": {
					"mode": "file",
					"file": {}
				},
				"url": {
					"raw": "{{s3_presigned_url}}",
					"host": [
						"{{s3_presigned_url}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Step 3: Trigger Extraction Processing",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"patientId\": \"patient-demo-001\",\n    \"reportType\": \"lab_report\",\n    \"s3Key\": \"{{s3_key}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/reports/upload",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"reports",
						"upload"
					]
				}
			},
			"response": []
		},
		{
			"name": "Chat with Agent",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"patientId\": \"patient-demo-001\",\n    \"message\": \"What is my glucose trend?\",\n    \"conversationHistory\": []\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/chat",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"chat"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Reports",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/reports?patientId=patient-demo-001",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"reports"
					],
					"query": [
						{
							"key": "patientId",
							"value": "patient-demo-001"
						}
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "https://lyszq8emp5.execute-api.us-east-1.amazonaws.com/prod",
			"type": "string"
		},
		{
			"key": "api_key",
			"value": "I7SiDKhjuOOPLmuy2uEx5RSRtu9op7nkLU4MediA",
			"type": "string"
		},
		{
			"key": "s3_presigned_url",
