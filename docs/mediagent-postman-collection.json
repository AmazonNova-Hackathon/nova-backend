{
	"info": {
		"_postman_id": "fdbe87f9-da03-49d7-83d2-c2e50529944a",
		"name": "MediAgent API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Upload Report",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"patientId\": \"patient-demo-001\",\n    \"reportType\": \"lab_report\",\n    \"imageBase64\": \"/9j/4AAQSk...\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/reports/upload",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"reports",
						"upload"
					]
				}
			},
			"response": []
		},
		{
			"name": "Chat with Agent",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"patientId\": \"patient-demo-001\",\n    \"message\": \"What is my glucose trend?\",\n    \"conversationHistory\": []\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/chat",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"chat"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Reports",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/reports?patientId=patient-demo-001",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"reports"
					],
					"query": [
						{
							"key": "patientId",
							"value": "patient-demo-001"
						}
					]
				}
			},
			"response": []
		}
